rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared field whitelist for all diagnostics writes
    function validDiagnosticsWrite() {
      return request.auth != null
        && request.resource.data.keys().hasOnly([
             'type', 'currency', 'date', 'attempts',
             'platform', 'timestamp'
           ]);
    }

    match /diagnostics/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    match /diagnostics_staging/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    match /diagnostics_dev/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    match /feedback/{docId} {
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'sentiment', 'message', 'userId', 'trigger',
             'platform', 'appVersion', 'createdAt'
           ]);
    }

  }
}
