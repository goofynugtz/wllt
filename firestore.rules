rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared field whitelist for all diagnostics writes
    function validDiagnosticsWrite() {
      return request.auth != null
        && request.resource.data.keys().hasOnly([
             'type', 'currency', 'date', 'attempts',
             'platform', 'timestamp'
           ]);
    }

    match /diagnostics/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    match /diagnostics_staging/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    match /diagnostics_dev/{path=**} {
      allow write: if validDiagnosticsWrite();
    }

    function validFeedbackWrite() {
      return request.auth != null
        && request.resource.data.keys().hasOnly([
             'sentiment', 'message', 'userId', 'trigger',
             'platform', 'appVersion', 'createdAt'
           ]);
    }

    match /feedback/{docId} {
      allow write: if validFeedbackWrite();
    }

    match /feedback_staging/{docId} {
      allow write: if validFeedbackWrite();
    }

    match /feedback_dev/{docId} {
      allow write: if validFeedbackWrite();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /transactions/{txId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /accounts/{accountId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /insights/{weekKey} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users_staging/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users_dev/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
